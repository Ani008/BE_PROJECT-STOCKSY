{
  "expo": {
    "name": "Stocksy Mobile",
    "owner": "stocksy",
    "slug": "stocksy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/StocksyLogoBlue.jpeg",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.stocksy.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.stocksy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/AndroidTransparentLogo.png",
        "backgroundColor": "#2563EB"
      }
    },
    "web": {
      "favicon": "./assets/StocksyLogoBlue.jpeg"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-video",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "91081826-ec63-45f3-8156-4e7e90cbb501"
      }
    }
  }
}
