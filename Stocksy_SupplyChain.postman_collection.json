{
  "info": {
    "name": "Stocksy - Supply Chain",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set collection variables: baseUrl (e.g. http://localhost:5050) and run Login first - it saves the token automatically."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": "you@example.com"
    },
    {
      "key": "password",
      "value": "your-password"
    }
  ],
  "item": [
    {
      "name": "0. Login (saves token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "const t = j.token || (j.data && j.data.token);",
              "if (t) { pm.collectionVariables.set('token', t); }",
              "pm.test('token saved', () => pm.expect(t).to.be.ok);"
            ]
          }
        }
      ]
    },
    {
      "name": "NTPC - 5 suppliers / 5 customers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/supply-chain/NTPC",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "supply-chain",
            "NTPC"
          ]
        },
        "description": "Left = suppliers, right = customers.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('5 suppliers', () => pm.expect(j.suppliers.length).to.eql(5));",
              "pm.test('5 customers', () => pm.expect(j.customers.length).to.eql(5));",
              "pm.test('node shape', () => pm.expect(j.suppliers[0]).to.have.all.keys('name','symbol','companyType','item','confidence','sourceUrl','tappable'));"
            ]
          }
        }
      ]
    },
    {
      "name": "COALINDIA",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/supply-chain/COALINDIA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "supply-chain",
            "COALINDIA"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Lowercase symbol (ntpc)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/supply-chain/ntpc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "supply-chain",
            "ntpc"
          ]
        },
        "description": "Symbol is case-insensitive.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown symbol -> 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/supply-chain/FAKESYM",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "supply-chain",
            "FAKESYM"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));",
              "pm.test('NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('NOT_FOUND'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Bad symbol -> 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/supply-chain/NTPC%26%26!",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "supply-chain",
            "NTPC%26%26!"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "No token -> 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/supply-chain/NTPC",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "supply-chain",
            "NTPC"
          ]
        },
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}